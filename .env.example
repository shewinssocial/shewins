# Copy this file to .env.local for local development, and set the same
# keys in your Vercel project settings for production.
#
# Only VITE_-prefixed variables are exposed to the browser bundle — never
# put a secret (service-role key, Cloudinary API secret) in a VITE_ variable.

# --- Supabase (safe to expose — the anon key is public by design;
#     access is enforced by Row Level Security, see supabase/schema.sql) ---
VITE_SUPABASE_URL=https://uvsrkhgoffzihgmbrqwk.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV2c3JraGdvZmZ6aWhnbWJycXdrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxOTc1NjEsImV4cCI6MjEwMzc3MzU2MX0.21o5SXXCiLZKLxU4l1gV9b1MlambV3M2VQyNXlBxtN4

# --- Cloudinary (unsigned upload preset — safe to expose; see README
#     "Cloudinary setup" for how to create an unsigned preset scoped to
#     a single upload folder) ---
VITE_CLOUDINARY_CLOUD_NAME=yqhidmcd
VITE_CLOUDINARY_UPLOAD_PRESET=shewins

# --- Server-side only (Supabase Edge Function), NOT prefixed with VITE_,
#     NOT read by the frontend. Set these as Supabase Function secrets
#     (`supabase secrets set ...`), never in this file or in Vercel. ---
